<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Miga" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Launch theme: the system splash screen (the app icon on the paper colour) stays until the
         settings have loaded, then MainActivity switches to Theme.Miga and shows the right screen
         at once (see installSplashScreen there). -->
    <style name="Theme.Miga.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Miga</item>
    </style>
</resources>
