<?xml version="1.0" encoding="utf-8"?>
<!-- Same content as backup_rules.xml: recipes, photos and settings (see the comment there about
     the encrypted AI keys). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="photos/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="miga_locale.xml" />
        <include domain="sharedpref" path="miga_cook_mode.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="photos/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="miga_locale.xml" />
        <include domain="sharedpref" path="miga_cook_mode.xml" />
    </device-transfer>
</data-extraction-rules>
