<?xml version="1.0" encoding="utf-8"?>
<!--
    Permite tráfico HTTP sin cifrar (no solo HTTPS) para el servidor de sincronización
    self-hosted: es habitual que viva en una LAN doméstica (http://192.168.x.x:puerto) sin TLS.
    El resto de servicios de la app (Gemini, Anthropic, GitHub) siguen siendo HTTPS y no se ven
    afectados por este cambio.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
